// SemVer 2.0 parser, constraint evaluator, and version comparator.

fn strip_v_prefix(raw) {
    let s = trim(raw)
    if starts_with(s, "v") || starts_with(s, "V") {
        return slice(s, 1, len(s))
    }
    return s
}

fn is_all_digits(s) {
    if len(s) == 0 {
        return false
    }
    let i = 0
    while i < len(s) {
        let ch = slice(s, i, i + 1)
        let code = char_code(ch)
        if code < 48 || code > 57 {
            return false
        }
        i = i + 1
    }
    return true
}

fn parse_semver(raw) {
    let s = strip_v_prefix(raw)
    let plus_idx = index_of(s, "+")
    let build = ""
    if plus_idx >= 0 {
        build = slice(s, plus_idx + 1, len(s))
        s = slice(s, 0, plus_idx)
    }

    let dash_idx = index_of(s, "-")
    let pre = ""
    if dash_idx >= 0 {
        pre = slice(s, dash_idx + 1, len(s))
        s = slice(s, 0, dash_idx)
    }

    let parts = split(s, ".")
    if len(parts) < 2 || len(parts) > 3 {
        return { "valid": false, "major": 0, "minor": 0, "patch": 0, "pre": "", "build": "" }
    }
    let maj_s = parts[0]
    let min_s = parts[1]
    let pat_s = "0"
    if len(parts) == 3 {
        pat_s = parts[2]
    }
    if !is_all_digits(maj_s) || !is_all_digits(min_s) || !is_all_digits(pat_s) {
        return { "valid": false, "major": 0, "minor": 0, "patch": 0, "pre": "", "build": "" }
    }
    return {
        "valid": true,
        "major": int(num(maj_s)),
        "minor": int(num(min_s)),
        "patch": int(num(pat_s)),
        "pre": pre,
        "build": build
    }
}

fn format_semver(v) {
    let base = str(v["major"]) + "." + str(v["minor"]) + "." + str(v["patch"])
    if len(v["pre"]) > 0 {
        base = base + "-" + v["pre"]
    }
    if len(v["build"]) > 0 {
        base = base + "+" + v["build"]
    }
    return base
}

fn compare_prerelease(a, b) {
    if a == b {
        return 0
    }
    if len(a) == 0 {
        return 1
    }
    if len(b) == 0 {
        return -1
    }
    let pa = split(a, ".")
    let pb = split(b, ".")
    let limit = len(pa)
    if len(pb) < limit {
        limit = len(pb)
    }
    let i = 0
    while i < limit {
        let xa = pa[i]
        let xb = pb[i]
        if xa != xb {
            let na = is_all_digits(xa)
            let nb = is_all_digits(xb)
            if na && nb {
                let va = num(xa)
                let vb = num(xb)
                if va < vb { return -1 }
                if va > vb { return 1 }
            } else if na && !nb {
                return -1
            } else if !na && nb {
                return 1
            } else {
                if xa < xb { return -1 }
                return 1
            }
        }
        i = i + 1
    }
    if len(pa) < len(pb) { return -1 }
    if len(pa) > len(pb) { return 1 }
    return 0
}

fn compare_semver(a_raw, b_raw) {
    let a = parse_semver(a_raw)
    let b = parse_semver(b_raw)
    if a["major"] != b["major"] {
        if a["major"] < b["major"] { return -1 }
        return 1
    }
    if a["minor"] != b["minor"] {
        if a["minor"] < b["minor"] { return -1 }
        return 1
    }
    if a["patch"] != b["patch"] {
        if a["patch"] < b["patch"] { return -1 }
        return 1
    }
    return compare_prerelease(a["pre"], b["pre"])
}

fn satisfies_constraint(version_raw, constraint_raw) {
    let c = trim(constraint_raw)
    if len(c) == 0 || c == "*" {
        return true
    }
    let v = parse_semver(version_raw)
    if !v["valid"] {
        return false
    }
    if starts_with(c, ">=") {
        return compare_semver(version_raw, trim(slice(c, 2, len(c)))) >= 0
    }
    if starts_with(c, "<=") {
        return compare_semver(version_raw, trim(slice(c, 2, len(c)))) <= 0
    }
    if starts_with(c, ">") {
        return compare_semver(version_raw, trim(slice(c, 1, len(c)))) > 0
    }
    if starts_with(c, "<") {
        return compare_semver(version_raw, trim(slice(c, 1, len(c)))) < 0
    }
    if starts_with(c, "=") {
        return compare_semver(version_raw, trim(slice(c, 1, len(c)))) == 0
    }
    if starts_with(c, "^") {
        let base_s = trim(slice(c, 1, len(c)))
        let base = parse_semver(base_s)
        if !base["valid"] { return false }
        if compare_semver(version_raw, base_s) < 0 { return false }
        if base["major"] > 0 {
            return v["major"] == base["major"]
        }
        if base["minor"] > 0 {
            return v["major"] == 0 && v["minor"] == base["minor"]
        }
        return v["major"] == 0 && v["minor"] == 0 && v["patch"] == base["patch"]
    }
    if starts_with(c, "~") {
        let base_s = trim(slice(c, 1, len(c)))
        let base = parse_semver(base_s)
        if !base["valid"] { return false }
        if compare_semver(version_raw, base_s) < 0 { return false }
        return v["major"] == base["major"] && v["minor"] == base["minor"]
    }
    return compare_semver(version_raw, c) >= 0
}

fn classify_transition(from_ver, to_ver) {
    if from_ver == null || len(str(from_ver)) == 0 {
        return "install"
    }
    let cmp = compare_semver(from_ver, to_ver)
    if cmp < 0 { return "upgrade" }
    if cmp > 0 { return "downgrade" }
    return "noop"
}
